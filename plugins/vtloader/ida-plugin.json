{
  "IDAMetadataDescriptorVersion": 1,
  "plugin": {
    "name": "vtloader",
    "version": "1.0.0",
    "entryPoint": "vtloader_entry.py",
    "description": "Load a file from VirusTotal into IDA without writing it to disk",
    "license": "Apache 2.0",
    "idaVersions": ">=9.2",
    "platforms": [
      "windows-x86_64",
      "linux-x86_64",
      "macos-x86_64",
      "macos-aarch64"
    ],
    "categories": [
      "file-parsers-and-loaders",
      "malware-analysis"
    ],
    "keywords": [
      "loader",
      "virustotal",
      "malware",
      "in-memory",
      "shellcode"
    ],
    "urls": {
      "repository": "https://github.com/williballenthin/idawilli"
    },
    "authors": [
      {
        "name": "Willi Ballenthin",
        "email": "wballenthin@hex-rays.com"
      }
    ],
    "pythonDependencies": [
      "ida-settings>=3.5.1"
    ],
    "settings": [
      {
        "key": "vt_api_key",
        "type": "string",
        "required": false,
        "name": "VirusTotal API key",
        "documentation": "API key used to download files from VirusTotal. Downloads need a key with the file download privilege."
      }
    ]
  }
}
